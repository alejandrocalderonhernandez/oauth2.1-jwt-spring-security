                "exec": [
                  "pm.test('Token renovado', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('cc_old_refresh_token', pm.collectionVariables.get('cc_refresh_token'));",
                  "  pm.collectionVariables.set('cc_access_token', b.access_token);",
                  "  pm.collectionVariables.set('cc_refresh_token', b.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
