    {
      "name": "Authorization Server",
      "description": "Ejecuta la carpeta completa con Run folder, o envía los pasos 1 a 5 en orden. El paso 5 devuelve el JWT.",
      "item": [
        {
          "name": "1. Iniciar autorización",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 302', () => pm.expect(pm.response.code).to.eql(302));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/oauth2/authorize?response_type=code&client_id={{client_id}}&redirect_uri={{redirect_uri}}&scope=mission.read%20mission.write&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256&state=postman",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}"
                },
                {
                  "key": "scope",
                  "value": "mission.read%20mission.write"
                },
                {
                  "key": "code_challenge",
                  "value": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                },
                {
                  "key": "state",
                  "value": "postman"
                }
              ]
            },
            "description": "Arranca el flujo Authorization Code + PKCE. El servidor responde 302 (hacia /login, o directo con el code si ya había sesión)."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "2. Formulario de login (csrf)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "const m = html.match(/name=\"_csrf\"[^>]*value=\"([^\"]+)\"/) || html.match(/value=\"([^\"]+)\"[^>]*name=\"_csrf\"/);",
                  "pm.test('Se encontró el token _csrf', () => pm.expect(m).to.not.be.null);",
                  "if (m) pm.collectionVariables.set('csrf_token', m[1]);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Lee el formulario de login y guarda el token _csrf en la variable csrf_token."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "3. Enviar credenciales",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '(sin Location)';",
                  "console.log('Paso 3 · status:', pm.response.code, '· Location:', loc);",
                  "pm.test('Login aceptado · Location: ' + loc, () => {",
                  "  pm.expect(pm.response.code, 'status').to.eql(302);",
                  "  pm.expect(loc, 'Volvió a /login (credenciales o csrf incorrectos)').to.not.include('/login');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Inicia sesión con login_username y login_password (cámbialos para probar otro usuario: admin, manager o user).",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{login_username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{login_password}}",
                  "type": "text"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrf_token}}",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "4. Obtener code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "console.log('Paso 4 · status:', pm.response.code, '· Location:', loc || '(sin Location)');",
                  "const m = loc.match(/[?&]code=([^&]+)/);",
                  "const why = !loc ? 'sin header Location (¿redirecciones activadas?)' : loc.includes('/login') ? 'el servidor pide login: la sesión del paso 3 no quedó iniciada' : 'Location inesperado';",
                  "pm.test(m ? 'Llegó un authorization code' : 'Sin code · ' + why + ' · Location: ' + loc, () => pm.expect(m).to.not.be.null);",
                  "if (m) pm.collectionVariables.set('auth_code', decodeURIComponent(m[1]));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/oauth2/authorize?response_type=code&client_id={{client_id}}&redirect_uri={{redirect_uri}}&scope=mission.read%20mission.write&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&code_challenge_method=S256&state=postman",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}"
                },
                {
                  "key": "scope",
                  "value": "mission.read%20mission.write"
                },
                {
                  "key": "code_challenge",
                  "value": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
                },
                {
                  "key": "code_challenge_method",
                  "value": "S256"
                },
                {
                  "key": "state",
                  "value": "postman"
                }
              ]
            },
            "description": "Con la sesión iniciada, el servidor responde 302 hacia redirect_uri?code=... Postman no sigue la redirección; el script guarda el code en auth_code."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "5. Canjear code por JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token emitido', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', b.access_token);",
                  "  const payload = JSON.parse(Buffer.from(b.access_token.split('.')[1], 'base64').toString());",
                  "  console.log('JWT payload:', payload);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/oauth2/token",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            },
            "description": "Cambia el code por el access_token (PKCE con code_verifier). Lo guarda en la variable access_token y muestra el payload del JWT en la consola de Postman. Un cliente público no recibe refresh_token.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code",
                  "type": "text"
                },
                {
                  "key": "code",
                  "value": "{{auth_code}}",
                  "type": "text"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{redirect_uri}}",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "code_verifier",
                  "value": "{{code_verifier}}",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth Server Privado (refresh token)",
      "description": "Cliente confidencial orion-backend: usa client_secret y SÍ recibe refresh token. Ejecuta la carpeta completa con Run folder, o envía P1 a P7 en orden. Carpeta independiente de Authorization Server (cliente público orion-frontend).",
      "item": [
        {
          "name": "P1. Iniciar autorización",
          "event": [
            {
