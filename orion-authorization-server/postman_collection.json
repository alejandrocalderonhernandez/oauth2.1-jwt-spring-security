              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 302', () => pm.expect(pm.response.code).to.eql(302));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/oauth2/authorize?response_type=code&client_id={{cc_client_id}}&redirect_uri={{cc_redirect_uri}}&scope=mission.read%20mission.write&state=postman",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{cc_client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{cc_redirect_uri}}"
                },
                {
                  "key": "scope",
                  "value": "mission.read%20mission.write"
                },
                {
                  "key": "state",
                  "value": "postman"
                }
              ]
            },
            "description": "Cliente confidencial orion-backend, flujo clásico de OAuth 2.0 con secreto (sin PKCE). El servidor responde 302 hacia /login, o directo con el code si ya había sesión."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "P2. Formulario de login (csrf)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "const m = html.match(/name=\"_csrf\"[^>]*value=\"([^\"]+)\"/) || html.match(/value=\"([^\"]+)\"[^>]*name=\"_csrf\"/);",
                  "pm.test('Se encontró el token _csrf', () => pm.expect(m).to.not.be.null);",
                  "if (m) pm.collectionVariables.set('csrf_token', m[1]);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Lee el formulario de login y guarda el token _csrf en csrf_token."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "P3. Enviar credenciales",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '(sin Location)';",
                  "pm.test('Login aceptado · Location: ' + loc, () => {",
                  "  pm.expect(pm.response.code, 'status').to.eql(302);",
                  "  pm.expect(loc, 'Volvió a /login (credenciales o csrf incorrectos)').to.not.include('/login');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/login",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Inicia sesión con login_username y login_password.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{login_username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{login_password}}",
                  "type": "text"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrf_token}}",
                  "type": "text"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "P4. Obtener code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loc = pm.response.headers.get('Location') || '';",
                  "console.log('P4 · status:', pm.response.code, '· Location:', loc || '(sin Location)');",
                  "const m = loc.match(/[?&]code=([^&]+)/);",
                  "const why = !loc ? 'sin header Location (¿redirecciones activadas?)' : loc.includes('/login') ? 'el servidor pide login: la sesión del paso P3 no quedó iniciada' : 'Location inesperado';",
                  "pm.test(m ? 'Llegó un authorization code' : 'Sin code · ' + why + ' · Location: ' + loc, () => pm.expect(m).to.not.be.null);",
                  "if (m) pm.collectionVariables.set('cc_auth_code', decodeURIComponent(m[1]));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{auth_url}}/oauth2/authorize?response_type=code&client_id={{cc_client_id}}&redirect_uri={{cc_redirect_uri}}&scope=mission.read%20mission.write&state=postman",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "oauth2",
                "authorize"
              ],
              "query": [
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "client_id",
                  "value": "{{cc_client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "{{cc_redirect_uri}}"
                },
                {
                  "key": "scope",
                  "value": "mission.read%20mission.write"
                },
                {
                  "key": "state",
                  "value": "postman"
                }
              ]
            },
            "description": "Con la sesión iniciada, el servidor responde 302 hacia cc_redirect_uri?code=... Postman no sigue la redirección; el script guarda el code en cc_auth_code."
          },
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "P5. Canjear code por access + refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token emitido', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  pm.test('Trae refresh_token', () => pm.expect(b.refresh_token).to.be.a('string'));",
                  "  pm.collectionVariables.set('cc_access_token', b.access_token);",
                  "  pm.collectionVariables.set('cc_refresh_token', b.refresh_token);",
                  "  const payload = JSON.parse(Buffer.from(b.access_token.split('.')[1], 'base64').toString());",
                  "  console.log('JWT payload:', payload);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
