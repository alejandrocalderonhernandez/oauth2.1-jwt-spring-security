            ],
            "url": {
              "raw": "{{auth_url}}/oauth2/token",
              "host": [
                "{{auth_url}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            },
            "description": "Canjea el refresh_token guardado por un access_token nuevo. El refresh_token rota: el anterior deja de servir y el nuevo se guarda solo.",
            "body": {
