    {
      "name": "CORS",
      "item": [
        {
          "name": "Preflight token (allowed origin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preflight accepted\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Allow-Origin matches frontend\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(pm.collectionVariables.get(\"frontendOrigin\"));",
                  "});",
                  "pm.test(\"Allowed methods include POST\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "Content-Type"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            }
          }
        },
        {
          "name": "Preflight token (disallowed origin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preflight rejected\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"No Allow-Origin header\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Access-Control-Allow-Origin\")).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{disallowedOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "Content-Type"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            }
          }
        },
