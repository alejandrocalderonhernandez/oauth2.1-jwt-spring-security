{
  "info": {
    "name": "Orion - Resource Server",
    "description": "API consumida por el frontend Orión del curso OAuth 2.1 con Spring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "No secure",
      "description": "Endpoints tal como están hoy: la API está completamente abierta, sin autenticación.",
      "item": [
        {
          "name": "Listar noticias",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Responde un arreglo JSON en la raíz\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/news",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "news"
              ]
            }
          }
        },
        {
          "name": "Listar misiones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Responde un arreglo JSON en la raíz\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Cada misión tiene crew y findings como arreglos\", function () {",
                  "    pm.response.json().forEach(function (mission) {",
                  "        pm.expect(mission.crew).to.be.an(\"array\");",
                  "        pm.expect(mission.findings).to.be.an(\"array\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/missions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "missions"
              ]
            }
          }
        },
        {
          "name": "Crear misión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"El cuerpo tiene id, status y message\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"id\");",
                  "    pm.expect(body).to.have.property(\"status\");",
                  "    pm.expect(body).to.have.property(\"message\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/missions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "missions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aurora Verde\",\n  \"destination\": \"Marte · Valles Marineris\",\n  \"objective\": \"Buscar señales de actividad en los cañones.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Preflight CORS de misiones",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status exitoso\", function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "pm.test(\"Access-Control-Allow-Origin es el origen del frontend\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(pm.collectionVariables.get(\"origin\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization,content-type"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/missions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "missions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Secure",
      "description": "Estas peticiones fallarán hasta que se implemente la seguridad en el Resource Server durante el curso. Rellena las variables userToken y adminToken con tokens válidos para probarlas.",
